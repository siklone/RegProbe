<Window x:Class="RegProbe.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:RegProbe.App.Behaviors"
        xmlns:controls="clr-namespace:RegProbe.App.Views.Controls"
        mc:Ignorable="d"
        Title="RegProbe"
        Width="1080"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        Background="#0B0F14"
        Icon="Resources/Brand/regprobe-mark.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontFamilyText}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="7"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowConfigurationCommand}"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowRepairsCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ShowAboutCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ClearFiltersCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="TrafficCommandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="18"
                                Height="18"
                                Background="Transparent">
                            <Grid>
                                <Ellipse x:Name="Dot"
                                         Width="10"
                                         Height="10"
                                         Fill="{TemplateBinding Foreground}"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"/>
                                <Path x:Name="Glyph"
                                      Width="7"
                                      Height="7"
                                      Stroke="#0D0D0D"
                                      StrokeThickness="1.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      Stretch="Fill"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Data="{TemplateBinding Tag}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShellTopTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7E8A9B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0,12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}">
                            <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <Border x:Name="Accent"
                                    Height="2"
                                    Width="22"
                                    CornerRadius="999"
                                    Background="#4F8CFF"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EAF1FB"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Value="True">
                                <Setter Property="Foreground" Value="#F5F9FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnvironmentChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#111A25"/>
            <Setter Property="BorderBrush" Value="#263545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D7E2F0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#111A25"/>
            <Setter Property="BorderBrush" Value="#263545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C9D6E8"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#152131"/>
                    <Setter Property="BorderBrush" Value="#355074"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchCommandButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#111A25"/>
            <Setter Property="BorderBrush" Value="#263545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DBE5F2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#152131"/>
                    <Setter Property="BorderBrush" Value="#355074"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusStripTokenBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#111A25"/>
            <Setter Property="BorderBrush" Value="#223041"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Background" Value="#102117"/>
                    <Setter Property="BorderBrush" Value="#2E7D4F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="info">
                    <Setter Property="Background" Value="#142338"/>
                    <Setter Property="BorderBrush" Value="#285EA8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warning">
                    <Setter Property="Background" Value="#2A2212"/>
                    <Setter Property="BorderBrush" Value="#8A5B18"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#0B0F14"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Panel.ZIndex="100"
                Background="#0D131B"
                BorderBrush="#1B2431"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0,16,0">
                <i:Interaction.Behaviors>
                    <behaviors:WindowTitleBarDragBehavior/>
                </i:Interaction.Behaviors>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="Resources/Brand/regprobe-mark.png"
                           Width="18"
                           Height="18"
                           Margin="0,0,8,0"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"/>
                    <TextBlock Text="RegProbe"
                               VerticalAlignment="Center"
                               Foreground="#F3F7FD"
                               FontSize="13"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <Button Content="Prod"
                                Style="{StaticResource EnvironmentChipButtonStyle}"/>
                        <Button Content="Staging"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding CanUseStagingEnvironment}"
                                ToolTip="{Binding StagingEnvironmentTooltip}"
                                Style="{StaticResource EnvironmentChipButtonStyle}"/>
                    </StackPanel>

                    <Border Margin="12,0,0,0"
                            Padding="10,4"
                            CornerRadius="999"
                            Background="#111A25"
                            BorderBrush="#243446"
                            BorderThickness="1">
                        <TextBlock Text="{Binding HostContextLabel}"
                                   Foreground="#9BA8BA"
                                   FontSize="11"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="Tweaks"
                            Command="{Binding ShowConfigurationCommand}"
                            Tag="{Binding IsConfigurationViewActive}"
                            Margin="0,0,16,0"
                            Style="{StaticResource ShellTopTabButtonStyle}"/>
                    <Button Content="Recovery"
                            Command="{Binding ShowRepairsCommand}"
                            Tag="{Binding IsRepairsViewActive}"
                            Margin="0,0,16,0"
                            Style="{StaticResource ShellTopTabButtonStyle}"/>
                    <Button Content="Diagnostics"
                            Command="{Binding ShowAboutCommand}"
                            Tag="{Binding IsAboutViewActive}"
                            Style="{StaticResource ShellTopTabButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Command="{Binding FocusSearchCommand}"
                            IsEnabled="{Binding CanFocusSearch}"
                            ToolTip="Focus the active search field (Ctrl+K)"
                            Style="{StaticResource SearchCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌕"
                                       Margin="0,0,8,0"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FocusSearchLabel}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Ctrl+K"
                                       Margin="8,0,0,0"
                                       Foreground="#6F8094"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Content="&#xE7F4;"
                            IsEnabled="False"
                            Style="{StaticResource TopIconButtonStyle}"/>
                    <Button Content="&#xE77B;"
                            IsEnabled="False"
                            Margin="0,0,12,0"
                            Style="{StaticResource TopIconButtonStyle}"/>

                    <Button Command="{Binding HostController.MinimizeCommand, ElementName=RootWindow}"
                            ToolTip="Minimize"
                            Foreground="#FEBC2E"
                            Tag="M 1,3.5 H 6"
                            Margin="0,0,8,0"
                            Style="{StaticResource TrafficCommandButtonStyle}"/>
                    <Button Command="{Binding HostController.ToggleMaximizeRestoreCommand, ElementName=RootWindow}"
                            ToolTip="Maximize or restore"
                            Foreground="#28C840"
                            Tag="M 1,1.2 H 6 V 5.8 H 1 Z"
                            Margin="0,0,8,0"
                            Style="{StaticResource TrafficCommandButtonStyle}"/>
                    <Button Command="{Binding HostController.CloseCommand, ElementName=RootWindow}"
                            ToolTip="Close"
                            Foreground="#FF5F57"
                            Tag="M 1,1 L 6,6 M 6,1 L 1,6"
                            Style="{StaticResource TrafficCommandButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Panel.ZIndex="90"
                Background="#0D131B"
                BorderBrush="#182230"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0,18,0">
                <ItemsControl ItemsSource="{Binding StatusStripTokens}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusStripTokenBorderStyle}">
                                <TextBlock Text="{Binding Text}"
                                           Foreground="#D6E0EE"
                                           FontSize="10"
                                           FontWeight="Medium"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Background="#5A211B"
                        Padding="16,12"
                        Visibility="{Binding HasPendingRollbacks, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Foreground="#FFF3F1"
                                   Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Crash recovery required"
                                       Foreground="#FFF3F1"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding PendingRollbackMessage}"
                                       Foreground="#F4D8D3"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding RecoverPendingRollbacksCommand}"
                                    Style="{StaticResource AppQuietActionButtonStyle}"
                                    Background="#1F5C39"
                                    Foreground="#F0FFF5"
                                    Margin="0,0,8,0"
                                    Content="Recover"/>
                            <Button Command="{Binding DismissPendingRollbacksCommand}"
                                    Style="{StaticResource AppQuietActionButtonStyle}"
                                    Background="Transparent"
                                    BorderBrush="#F0D3CE"
                                    Foreground="#F0D3CE"
                                    Content="Dismiss"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#173245"
                        Padding="16,12"
                        Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="#EAF6FF"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="Recovering pending rollbacks..."
                                   Foreground="#EAF6FF"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#0B0F14"
                    BorderBrush="#0F151D"
                    BorderThickness="0,1,0,0">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <i:Interaction.Behaviors>
                        <behaviors:NavigationTransitionBehavior Transition="FadeAndSlide"/>
                    </i:Interaction.Behaviors>
                </ContentControl>
            </Border>
        </Grid>

        <controls:NotificationHost x:Name="NotificationHost"
                                   Panel.ZIndex="200"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   IsHitTestVisible="True"/>

        <controls:LoadingOverlay DataContext="{Binding BusyService}"
                                 Panel.ZIndex="300"
                                 d:IsHidden="True"/>
    </Grid>
</Window>
