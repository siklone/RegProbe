<UserControl x:Class="RegProbe.App.Views.ContributorLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RegProbe.App.Views"
             Background="#0D0D0D"
             FontFamily="{DynamicResource FontFamilyText}"
             FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ContributorCardStyle" TargetType="Border" BasedOn="{StaticResource UtilitySectionBorderStyle}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ContributorMonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource UtilitySubtleMonoTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="ReadinessItemTemplate">
            <Border Background="#111111"
                    BorderBrush="#242424"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,8,8">
                <StackPanel Width="210">
                    <TextBlock Text="{Binding Label}"
                               Foreground="#F2F2F2"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Status}"
                               Margin="0,4,0,0"
                               Foreground="#BFD8C5"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               FontSize="10"/>
                    <TextBlock Text="{Binding Detail}"
                               Margin="0,5,0,0"
                               Foreground="#A8A8A8"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CommandPackTemplate">
            <Border Background="#101010"
                    BorderBrush="#242424"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="11"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#F5F5F5"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Tier, StringFormat={}  [{0}]}"
                                       Foreground="#9FB5D7"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding SafetyLabel, StringFormat={}  {0}}"
                                       Foreground="#D7B79F"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       FontSize="10"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Purpose}"
                                   Margin="0,5,0,0"
                                   Foreground="#B8B8B8"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ExecutionPolicyLabel}"
                                   Margin="0,5,0,0"
                                   Foreground="#D7B79F"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Command}"
                                   Margin="0,7,0,0"
                                   Foreground="#DCDCDC"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Copy"
                            Command="{Binding CopyCommand}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ObservationTemplate">
            <Border Background="#101010"
                    BorderBrush="#242424"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Index, StringFormat={}# {0}}"
                                   Foreground="#888888"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="10"/>
                        <TextBlock Text="{Binding Bucket}"
                                   Margin="0,5,0,0"
                                   Foreground="#D7B79F"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ValueName}"
                                   Foreground="#F5F5F5"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegistryPath}"
                                   Margin="0,4,0,0"
                                   Foreground="#888888"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="9"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Reason}"
                                   Margin="0,6,0,0"
                                   Foreground="#B8B8B8"
                                   TextWrapping="Wrap"/>
                        <Border Margin="0,8,0,0"
                                Padding="8"
                                Background="#171307"
                                BorderBrush="#5A431A"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="{Binding NextAction}"
                                           Foreground="#F4D293"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding AppCardReadinessSummary, StringFormat={}App-card readiness: {0}}"
                                           Margin="0,4,0,0"
                                           Foreground="#D7B79F"
                                           FontFamily="{DynamicResource FontFamilyMono}"
                                           FontSize="9"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MissingProofSummary}"
                                           Margin="0,3,0,0"
                                           Foreground="#B8B8B8"
                                           FontFamily="{DynamicResource FontFamilyMono}"
                                           FontSize="9"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SurfaceDestination, StringFormat={}Surface: {0}}"
                                   Margin="0,6,0,0"
                                   Foreground="#D7B79F"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="9"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PromotionChecklist, StringFormat={}Promotion gate: {0}}"
                                   Margin="0,4,0,0"
                                   Foreground="#A8A8A8"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="9"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CommandHint}"
                                   Margin="0,6,0,0"
                                   Foreground="#9FB5D7"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="9"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="12,0,0,0">
                        <TextBlock Text="{Binding DefaultSummary, StringFormat={}Default: {0}}"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding CandidateValues, StringFormat={}Values: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding ValidatedValues, StringFormat={}Validated: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding ConfidenceSummary, StringFormat={}Confidence: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding NoiseSummary, StringFormat={}Noise: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding NoiseBadge, StringFormat={}Badge: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding RunTierAction, StringFormat={}Tier action: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding TestedValueSummary, StringFormat={}Tested: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding VerdictSummary, StringFormat={}Verdicts: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding SmokeSummary, StringFormat={}Smoke: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding ClaimBoundary, StringFormat={}Boundary: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding AppCardBlockerSummary, StringFormat={}Blockers: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding ArtifactSummary, StringFormat={}Artifacts: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <views:UtilityPageChrome HeaderEyebrow="Contributor"
                             HeaderTitle="{Binding Title}"
                             HeaderDescription="{Binding Subtitle}">
        <views:UtilityPageChrome.BodyContent>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="980">
                    <Border Visibility="{Binding IsGateVisible, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource ContributorCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Unlock contributor features"
                                       Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource UtilitySectionBodyTextStyle}"
                                       Text="{Binding RiskGateSummary}"/>
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource UtilitySectionBodyTextStyle}"
                                       Text="{Binding RiskGateBoundary}"/>
                            <CheckBox IsChecked="{Binding RiskAcknowledged}"
                                      Margin="0,14,0,0"
                                      Foreground="#E7E7E7"
                                      Content="{Binding RiskAcknowledgementText}"/>
                            <Button Content="Enable Contributor Lab"
                                    Command="{Binding EnableContributorToolsCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsToolsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Lab dashboard"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="This dashboard separates normal app cards from contributor-only research so nobody has to read raw artifact folders first."
                                           Margin="0,6,0,10"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#0E1411"
                                            BorderBrush="#244A34"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="End-user surface"
                                                       Foreground="#F5F5F5"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding EndUserSurfaceSummary}"
                                                       Margin="0,6,0,0"
                                                       Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="#11100D"
                                            BorderBrush="#4A321E"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Contributor research"
                                                       Foreground="#F5F5F5"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ContributorResearchSummary}"
                                                       Margin="0,6,0,0"
                                                       Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4"
                                            Background="#080D12"
                                            BorderBrush="#263B50"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="{Binding ContributorLabOperatingMode}"
                                                           Foreground="#F5F5F5"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding VerificationBadge, StringFormat={}  [{0}]}"
                                                           Foreground="#9FB5D7"
                                                           FontFamily="{DynamicResource FontFamilyMono}"
                                                           FontSize="10"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding ContributorLabOperatingModeDetail}"
                                                       Margin="0,6,0,0"
                                                       Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Background="#080D12"
                                        BorderBrush="#1F3550"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,10,0,0">
                                    <TextBlock Text="{Binding ContributorActionBoundarySummary}"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Readiness"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding RepoRoot}"
                                           Margin="0,5,0,10"
                                           Style="{StaticResource ContributorMonoTextStyle}"/>
                                <Border Background="#0E1411"
                                        BorderBrush="#244A34"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Next safe action"
                                                   Foreground="#F5F5F5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ContributorReadinessDecisionSummary}"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <WrapPanel>
                                    <ItemsControl ItemsSource="{Binding ReadinessItems}"
                                                  ItemTemplate="{StaticResource ReadinessItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Surface policy"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding AppSurfacePolicySummary}"
                                           Margin="0,6,0,8"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <Border Background="#120D08"
                                        BorderBrush="#4A321E"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Research-only boundary"
                                                   Foreground="#F5F5F5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CustomValueSurfaceBoundarySummary}"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding CustomValueGateBreakdown, StringFormat={}Custom value gate: {0}}"
                                           Margin="0,0,0,5"
                                           Style="{StaticResource ContributorMonoTextStyle}"/>
                                <TextBlock Text="{Binding CustomValueReviewReadySummary}"
                                           Margin="0,0,0,5"
                                           Style="{StaticResource ContributorMonoTextStyle}"/>
                                <TextBlock Text="{Binding CustomValueNextActionSummary}"
                                           Margin="0,0,0,8"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <WrapPanel>
                                    <TextBlock Text="{Binding AppCardPassCount, StringFormat={}App cards passing: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding AppCardCandidateCount, StringFormat={}Candidates: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding CustomValueRecordCount, StringFormat={}Custom value records: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding CustomValueReadyForAppCard, StringFormat={}App-card review-ready: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding CustomValueResearchOnlyCount, StringFormat={}Research-only: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding CustomValueBlockedByGate, StringFormat={}Blocked by gate: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding CustomValueNotAppSurfaceReady, StringFormat={}Not app-ready: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding CustomValueBlockedBySafety, StringFormat={}Safety blocked: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding CustomValueNeedsLowNoiseRerun, StringFormat={}Needs low-noise rerun: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding CustomValueNoisyResultCount, StringFormat={}Noisy: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding CustomValueNonOkCount, StringFormat={}Non-ok: {0}}"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Custom value workflow"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding CustomValueWorkflowSummary}"
                                           Margin="0,6,0,8"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <TextBlock Text="{Binding CertifiedMutationGuardSummary}"
                                           Margin="0,0,0,8"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <TextBlock Text="{Binding ContributorExecutionPolicySummary}"
                                           Margin="0,0,0,8"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <TextBlock Text="Minimum evidence before app-card review: known current/default/target value, clean host-noise metadata, boot and GUI smoke result, rollback result, and bounded claim text."
                                           Style="{StaticResource ContributorMonoTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Ask about a key/value"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="Start here for user-supplied registry path/value questions: does this key/value exist, what values are known, what evidence do we have, and what exact VM command should test the next value?"
                                           Margin="0,6,0,10"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <Border Background="#080D12"
                                        BorderBrush="#263B50"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CustomValueInputHelp}"
                                                   Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                        <TextBlock Text="{Binding CustomValueAppCardEntryCriteria}"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Registry path"
                                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                                        <TextBox Text="{Binding CustomRegistryPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,5,0,0"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Value name"
                                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                                        <TextBox Text="{Binding CustomValueName, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,5,0,0"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Values to check"
                                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                                        <TextBox Text="{Binding CustomExpectedValues, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,5,0,0"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding CustomValueWorkflowChecklist}"
                                           Margin="0,10,0,8"
                                           Style="{StaticResource ContributorMonoTextStyle}"/>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Static binary for Ghidra string xref"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBox Text="{Binding CustomStaticBinaryPath, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,5,0,0"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <Border Background="#080D12"
                                        BorderBrush="#263B50"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Single key investigation contract"
                                                   Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                        <TextBlock Text="{Binding CustomValueInvestigationContract}"
                                                   Margin="0,5,0,6"
                                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                                        <TextBlock Text="{Binding CustomValueStorySummary}"
                                                   Margin="0,0,0,6"
                                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                                        <TextBlock Text="{Binding CustomValueMutationBoundarySummary}"
                                                   Margin="0,0,0,8"
                                                   Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                        <ItemsControl ItemsSource="{Binding CustomValueEvidenceChecklist}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='- {0}'}"
                                                               Margin="0,2,0,0"
                                                               Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Run lookup"
                                            Command="{Binding RunCustomLookupCommand}"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                                    <Button Content="Run app QA map"
                                            Command="{Binding RunCustomAppQaCommand}"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                                    <Button Content="Run readiness"
                                            Command="{Binding RunAppReadinessCommand}"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                                    <Button Content="Run VM health"
                                            Command="{Binding RunVmHealthCommand}"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                                </WrapPanel>
                                <Border Background="#080D12"
                                        BorderBrush="#1F3550"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Text="{Binding CommandRunTitle}"
                                                       Foreground="#F5F5F5"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CommandRunStatus, StringFormat={}  [{0}]}"
                                                       Foreground="#9FB5D7"
                                                       FontFamily="{DynamicResource FontFamilyMono}"
                                                       FontSize="10"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding CommandRunOutput}"
                                                   Margin="0,7,0,0"
                                                   Foreground="#DCDCDC"
                                                   FontFamily="{DynamicResource FontFamilyMono}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Evidence discovery steps"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <TextBlock Text="Run these in order. The first three are read-only; VM mutation stays copy-only unless the certified VM health gate passes and the contributor confirms the run."
                                           Margin="0,4,0,8"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <ItemsControl ItemsSource="{Binding CustomValueDiscoverySteps}"
                                              ItemTemplate="{StaticResource CommandPackTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Command packs"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="These are allowlisted command templates. The WPF app does not execute arbitrary contributor commands in v1."
                                           Margin="0,6,0,10"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <ItemsControl ItemsSource="{Binding CommandPacks}"
                                              ItemTemplate="{StaticResource CommandPackTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Custom registry value experiments"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding CustomValueObservationBoundarySummary}"
                                           Margin="0,6,0,10"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <TextBlock Text="{Binding CustomValueSurfaceBoundarySummary}"
                                           Margin="0,0,0,8"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <TextBlock Text="{Binding ObservationBrowserSummary}"
                                           Margin="0,0,0,10"
                                           Style="{StaticResource ContributorMonoTextStyle}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Search value/path/verdict/blockers"
                                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                                        <TextBox Text="{Binding ObservationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,5,0,0"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bucket"
                                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                                        <ComboBox ItemsSource="{Binding ObservationBucketOptions}"
                                                  SelectedItem="{Binding ObservationBucketFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FilteredObservations}"
                                              ItemTemplate="{StaticResource ObservationTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Lock Contributor Lab"
                                Command="{Binding ResetAcknowledgmentCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,24"
                                Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </views:UtilityPageChrome.BodyContent>
    </views:UtilityPageChrome>
</UserControl>
