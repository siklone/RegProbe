<UserControl x:Class="RegProbe.App.Views.ContributorLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RegProbe.App.Views"
             Background="#0D0D0D"
             FontFamily="{DynamicResource FontFamilyText}"
             FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ContributorCardStyle" TargetType="Border" BasedOn="{StaticResource UtilitySectionBorderStyle}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ContributorMonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource UtilitySubtleMonoTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="ReadinessItemTemplate">
            <Border Background="#111111"
                    BorderBrush="#242424"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,8,8">
                <StackPanel Width="210">
                    <TextBlock Text="{Binding Label}"
                               Foreground="#F2F2F2"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Status}"
                               Margin="0,4,0,0"
                               Foreground="#BFD8C5"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               FontSize="10"/>
                    <TextBlock Text="{Binding Detail}"
                               Margin="0,5,0,0"
                               Foreground="#A8A8A8"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CommandPackTemplate">
            <Border Background="#101010"
                    BorderBrush="#242424"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="11"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#F5F5F5"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Tier, StringFormat={}  [{0}]}"
                                       Foreground="#9FB5D7"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding SafetyLabel, StringFormat={}  {0}}"
                                       Foreground="#D7B79F"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       FontSize="10"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Purpose}"
                                   Margin="0,5,0,0"
                                   Foreground="#B8B8B8"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Command}"
                                   Margin="0,7,0,0"
                                   Foreground="#DCDCDC"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Copy"
                            Command="{Binding CopyCommand}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ObservationTemplate">
            <Border Background="#101010"
                    BorderBrush="#242424"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Index, StringFormat={}# {0}}"
                                   Foreground="#888888"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="10"/>
                        <TextBlock Text="{Binding Bucket}"
                                   Margin="0,5,0,0"
                                   Foreground="#D7B79F"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ValueName}"
                                   Foreground="#F5F5F5"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegistryPath}"
                                   Margin="0,4,0,0"
                                   Foreground="#888888"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="9"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Reason}"
                                   Margin="0,6,0,0"
                                   Foreground="#B8B8B8"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CommandHint}"
                                   Margin="0,6,0,0"
                                   Foreground="#9FB5D7"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="9"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="12,0,0,0">
                        <TextBlock Text="{Binding DefaultSummary, StringFormat={}Default: {0}}"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding CandidateValues, StringFormat={}Values: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding ValidatedValues, StringFormat={}Validated: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding ConfidenceSummary, StringFormat={}Confidence: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                        <TextBlock Text="{Binding NoiseSummary, StringFormat={}Noise: {0}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ContributorMonoTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <views:UtilityPageChrome HeaderEyebrow="Contributor"
                             HeaderTitle="{Binding Title}"
                             HeaderDescription="{Binding Subtitle}">
        <views:UtilityPageChrome.BodyContent>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="980">
                    <Border Visibility="{Binding IsGateVisible, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource ContributorCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Unlock contributor features"
                                       Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource UtilitySectionBodyTextStyle}"
                                       Text="This area is for people validating registry behavior with disposable VMs, snapshots, and reproducible scripts. It can lead to registry mutation, guest reboot, broken boot states, or noisy benchmark data if used casually."/>
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource UtilitySectionBodyTextStyle}"
                                       Text="Normal RegProbe users should use Tweaks. Contributor Lab data is research context unless it is reference-eligible and backed by clean VM artifacts."/>
                            <CheckBox IsChecked="{Binding RiskAcknowledged}"
                                      Margin="0,14,0,0"
                                      Foreground="#E7E7E7"
                                      Content="I read this and understand that certified mutation requires a disposable Windows 11 VM, a clean snapshot, rollback proof, and tight noise gates."/>
                            <Button Content="Enable Contributor Lab"
                                    Command="{Binding EnableContributorToolsCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsToolsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Readiness"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding RepoRoot}"
                                           Margin="0,5,0,10"
                                           Style="{StaticResource ContributorMonoTextStyle}"/>
                                <WrapPanel>
                                    <ItemsControl ItemsSource="{Binding ReadinessItems}"
                                                  ItemTemplate="{StaticResource ReadinessItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Surface policy"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding AppSurfacePolicySummary}"
                                           Margin="0,6,0,8"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <WrapPanel>
                                    <TextBlock Text="{Binding AppCardPassCount, StringFormat={}App cards passing: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding AppCardCandidateCount, StringFormat={}Candidates: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding Operator96RecordCount, StringFormat={}Operator96 records: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding Operator96ReadyForAppCard, StringFormat={}Ready for app card: {0}}"
                                               Margin="0,0,18,0"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                    <TextBlock Text="{Binding Operator96NeedsLowNoiseRerun, StringFormat={}Needs low-noise rerun: {0}}"
                                               Style="{StaticResource ContributorMonoTextStyle}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Command packs"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="These are allowlisted command templates. The WPF app does not execute arbitrary contributor commands in v1."
                                           Margin="0,6,0,10"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <ItemsControl ItemsSource="{Binding CommandPacks}"
                                              ItemTemplate="{StaticResource CommandPackTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContributorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Operator96 research observations"
                                           Style="{StaticResource UtilitySectionTitleTextStyle}"/>
                                <TextBlock Text="Clean observations stay here until defaults, rollback, explicit app writes, and bounded claims are strong enough for normal cards."
                                           Margin="0,6,0,10"
                                           Style="{StaticResource UtilitySectionBodyTextStyle}"/>
                                <ItemsControl ItemsSource="{Binding Observations}"
                                              ItemTemplate="{StaticResource ObservationTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Lock Contributor Lab"
                                Command="{Binding ResetAcknowledgmentCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,24"
                                Style="{StaticResource UtilityInlineLinkButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </views:UtilityPageChrome.BodyContent>
    </views:UtilityPageChrome>
</UserControl>
