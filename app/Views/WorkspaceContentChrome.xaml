<UserControl x:Class="RegProbe.App.Views.WorkspaceContentChrome"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RegProbe.App.Behaviors"
             mc:Ignorable="d"
             Background="#151515"
             FontFamily="{DynamicResource FontFamilyText}"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RegProbe.App;component/Resources/TweaksWorkspaceResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#151515">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="12,8,16,8">
            <Grid MaxWidth="1040" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentWorkspaceLabel}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding CurrentWorkspaceDescription}" Margin="0,3,0,0" FontSize="12" Foreground="#ABABAB" TextWrapping="Wrap" MaxWidth="720"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="12,7,16,7">
            <Grid MaxWidth="1040" HorizontalAlignment="Left">
                <WrapPanel ItemWidth="228">
                    <Border Width="228"
                            Margin="0,0,8,8"
                            Tag="{Binding WorkspacePendingSummaryState}"
                            Style="{StaticResource WorkspaceSummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding WorkspacePendingSummaryLabel}" Style="{StaticResource SectionEyebrowStyle}"/>
                            <TextBlock Text="{Binding WorkspacePendingSummaryValue}" Style="{StaticResource WorkspaceSummaryValueStyle}"/>
                            <TextBlock Text="{Binding WorkspacePendingSummaryText}" Style="{StaticResource WorkspaceSummaryDetailStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Width="228"
                            Margin="0,0,8,8"
                            Tag="{Binding WorkspaceRollbackSummaryState}"
                            Style="{StaticResource WorkspaceSummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding WorkspaceRollbackSummaryLabel}" Style="{StaticResource SectionEyebrowStyle}"/>
                            <TextBlock Text="{Binding WorkspaceRollbackSummaryValue}" Style="{StaticResource WorkspaceSummaryValueStyle}"/>
                            <TextBlock Text="{Binding WorkspaceRollbackSummaryText}" Style="{StaticResource WorkspaceSummaryDetailStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Width="228"
                            Margin="0,0,8,8"
                            Tag="{Binding WorkspaceElevationSummaryState}"
                            Style="{StaticResource WorkspaceSummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding WorkspaceElevationSummaryLabel}" Style="{StaticResource SectionEyebrowStyle}"/>
                            <TextBlock Text="{Binding WorkspaceElevationSummaryValue}" Style="{StaticResource WorkspaceSummaryValueStyle}"/>
                            <TextBlock Text="{Binding WorkspaceElevationSummaryText}" Style="{StaticResource WorkspaceSummaryDetailStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Width="228"
                            Margin="0,0,0,8"
                            Tag="{Binding WorkspaceVerificationSummaryState}"
                            Style="{StaticResource WorkspaceSummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding WorkspaceVerificationSummaryLabel}" Style="{StaticResource SectionEyebrowStyle}"/>
                            <TextBlock Text="{Binding WorkspaceVerificationSummaryValue}" Style="{StaticResource WorkspaceSummaryValueStyle}"/>
                            <TextBlock Text="{Binding WorkspaceVerificationSummaryText}" Style="{StaticResource WorkspaceSummaryDetailStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="12,8,16,8">
            <Grid MaxWidth="1040" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="256"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Row="0"
                             Grid.Column="0"
                             HorizontalAlignment="Left"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBoxStyle}"
                             Tag="{Binding SearchPlaceholder}"
                             ToolTip="{Binding SearchPlaceholder}">
                        <i:Interaction.Behaviors>
                            <behaviors:FocusOnRequestBehavior RequestToken="{Binding SearchFocusRequestId}"/>
                        </i:Interaction.Behaviors>
                    </TextBox>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Width="1"
                            Height="16"
                            Background="#353535"
                            VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="{Binding FilterSummary}"
                               Margin="0,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#7D7D7D"/>

                    <Grid Grid.Row="1"
                          Grid.ColumnSpan="3"
                          Margin="0,8,0,0">
                        <WrapPanel>
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsWorkspaceSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <CheckBox Tag="Favorites" IsChecked="{Binding ShowFavoritesOnly}" Style="{StaticResource ChipStyle}">
                                <TextBlock>
                                    <Run Text="Favorites"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding FavoritesCount, Mode=OneWay}"/>
                                </TextBlock>
                            </CheckBox>
                            <CheckBox Tag="Safe" IsChecked="{Binding ShowSafe}" Style="{StaticResource ChipStyle}"><TextBlock Text="Safe"/></CheckBox>
                            <CheckBox Tag="Advanced" IsChecked="{Binding ShowAdvanced}" Style="{StaticResource ChipStyle}"><TextBlock Text="Advanced"/></CheckBox>
                            <CheckBox Tag="Risky" IsChecked="{Binding ShowRisky}" Style="{StaticResource ChipStyle}"><TextBlock Text="Risky"/></CheckBox>
                            <CheckBox Tag="ClassA" IsChecked="{Binding ShowClassA}" Style="{StaticResource ChipStyle}"><TextBlock Text="Class A"/></CheckBox>
                            <CheckBox Tag="ClassB" IsChecked="{Binding ShowClassB}" Style="{StaticResource ChipStyle}"><TextBlock Text="Class B"/></CheckBox>
                            <CheckBox Tag="ClassD" IsChecked="{Binding ShowClassD}" Style="{StaticResource ChipStyle}"><TextBlock Text="Class D"/></CheckBox>
                        </WrapPanel>

                        <WrapPanel>
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMaintenanceWorkspaceSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <CheckBox Tag="Safe" IsChecked="{Binding ShowSafe}" Style="{StaticResource ChipStyle}"><TextBlock Text="Safe"/></CheckBox>
                            <CheckBox Tag="Advanced" IsChecked="{Binding ShowAdvanced}" Style="{StaticResource ChipStyle}"><TextBlock Text="Advanced"/></CheckBox>
                            <CheckBox Tag="Risky" IsChecked="{Binding ShowRisky}" Style="{StaticResource ChipStyle}"><TextBlock Text="Risky"/></CheckBox>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="12,8,16,0" MaxWidth="1040" HorizontalAlignment="Left">
            <ListBox ItemsSource="{Binding ElementName=Root, Path=ItemsSource}"
                     ItemTemplate="{Binding ElementName=Root, Path=ItemTemplate}"
                     ItemContainerStyle="{StaticResource TweakListItemStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVisibleTweaks}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
            </ListBox>

            <Border Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVisibleTweaks}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EmptyStateTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#ECECEC" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyStateDescription}" Margin="0,6,0,0" FontSize="11" Foreground="#666666" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="{Binding EmptyStateActionText}" Command="{Binding ResetFiltersCommand}" Style="{StaticResource FlatButtonStyle}" MinWidth="120" Margin="0,0,8,0" HorizontalAlignment="Center"/>
                        <Button Content="{Binding ClearCategorySelectionText}" Command="{Binding ClearCategorySelectionCommand}" Style="{StaticResource FlatButtonStyle}" MinWidth="152" Visibility="{Binding CanClearCategorySelection, Converter={StaticResource BoolToVisibility}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
