<UserControl x:Class="RegProbe.App.Views.Tweaks.TweaksSecondaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RegProbe.App.Behaviors"
             Background="Transparent">
    <Border Background="{DynamicResource ResearchCardBrush}"
            BorderBrush="#0E0E0E"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Width="28"
                        Padding="0"
                        Content="☰"
                        Command="{Binding ToggleSecondaryPanelCommand}"
                        Style="{StaticResource SecondaryPanelButtonStyle}"/>

                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsSecondaryPanelCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="RESEARCH CARDS"
                               Foreground="{DynamicResource ResearchTextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource FontFamilyMono}"/>
                    <TextBlock Text="Analysis-first surfaces with proof, key path, and mutation controls kept in the background."
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                               FontSize="9"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="14,0,14,10"
                        Visibility="{Binding IsSecondaryPanelCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding SecondaryPanelSearchPlaceholder}"
                         ToolTip="{Binding SecondaryPanelSearchPlaceholder}"
                         Style="{StaticResource CompactSearchBoxStyle}">
                    <i:Interaction.Behaviors>
                        <behaviors:FocusOnRequestBehavior RequestToken="{Binding SearchFocusRequestId}"/>
                    </i:Interaction.Behaviors>
                </TextBox>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="14,0,14,10"
                        Visibility="{Binding IsSecondaryPanelCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="FILTERS"
                           Margin="0,0,0,6"
                           Style="{StaticResource SectionEyebrowStyle}"/>

                <WrapPanel Margin="0,0,0,8">
                    <CheckBox Tag="Safe"
                              IsChecked="{Binding ShowSafe}"
                              Style="{StaticResource ChipStyle}">
                        <TextBlock Text="LOW"/>
                    </CheckBox>
                    <CheckBox Tag="Advanced"
                              IsChecked="{Binding ShowAdvanced}"
                              Style="{StaticResource ChipStyle}">
                        <TextBlock Text="ADVANCED"/>
                    </CheckBox>
                    <CheckBox Tag="Risky"
                              IsChecked="{Binding ShowRisky}"
                              Style="{StaticResource ChipStyle}">
                        <TextBlock Text="HIGH"/>
                    </CheckBox>
                </WrapPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{Binding StatusFilterDisplayText}"
                            Command="{Binding CycleStatusFilterCommand}"
                            ToolTip="Cycle status filter: all, applied, rolled back"
                            Style="{StaticResource CompactFilterButtonStyle}"/>

                    <Button Grid.Column="2"
                            Content="{Binding ScopeFilterDisplayText}"
                            Command="{Binding CycleScopeFilterCommand}"
                            ToolTip="Cycle scope filter: all, machine, user, mixed"
                            Style="{StaticResource CompactFilterButtonStyle}"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="3"
                  Margin="8,0,8,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding TweaksView}"
                         SelectedItem="{Binding SelectedTweakPane.SelectedTweak, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SecondaryPanelListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource ResearchPanelBrush}"
                                    BorderBrush="{DynamicResource ResearchBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="AccentRail"
                                            Background="{Binding ResearchAccentBrush}"
                                            CornerRadius="8,0,0,8"/>

                                    <Grid Grid.Column="1"
                                          Margin="10,10,10,10">
                                        <StackPanel Visibility="{Binding DataContext.IsSecondaryPanelCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding CategoryIcon}"
                                                       Foreground="{Binding ResearchAccentBrush}"
                                                       FontFamily="{DynamicResource FontFamilyMono}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding EvidenceClassBadgeText}"
                                                       Margin="0,5,0,0"
                                                       Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                                       FontFamily="{DynamicResource FontFamilyMono}"
                                                       FontSize="8"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding DataContext.IsSecondaryPanelCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ResearchAccentLabel}"
                                                           Foreground="{Binding ResearchAccentBrush}"
                                                           FontSize="8"
                                                           FontWeight="Bold"
                                                           FontFamily="{DynamicResource FontFamilyMono}"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                        Background="{Binding ResearchStatusBadgeBackgroundBrush}"
                                                        BorderBrush="{Binding ResearchStatusBadgeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding ResearchStatusBadgeText}"
                                                               Foreground="{Binding ResearchStatusBadgeForegroundBrush}"
                                                               FontSize="8"
                                                               FontWeight="Bold"
                                                               FontFamily="{DynamicResource FontFamilyMono}"/>
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,6,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource ResearchTextPrimaryBrush}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,8,0"/>
                                                <Border Grid.Column="1"
                                                        Background="{Binding EvidenceTierBackgroundBrush}"
                                                        BorderBrush="{Binding EvidenceTierBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding EvidenceClassBadgeText}"
                                                               Foreground="{Binding EvidenceTierForegroundBrush}"
                                                               FontSize="8"
                                                               FontWeight="Bold"
                                                               FontFamily="{DynamicResource FontFamilyMono}"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding RegistryPath}"
                                                       Foreground="{DynamicResource ResearchTextMutedBrush}"
                                                       FontSize="9"
                                                       FontFamily="{DynamicResource FontFamilyMono}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <ItemsControl Margin="0,6,0,0"
                                                          ItemsSource="{Binding ProofLanes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,4,4"
                                                                Padding="5,2"
                                                                Background="{Binding StateBackgroundBrush}"
                                                                BorderBrush="{Binding StateBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                            <TextBlock Text="{Binding Label}"
                                                                       Foreground="{Binding StateForegroundBrush}"
                                                                       FontSize="8"
                                                                       FontWeight="Bold"
                                                                       FontFamily="{DynamicResource FontFamilyMono}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#141414"/>
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ResearchBorderHoverBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ResearchAccentBrush}"/>
                                    <Setter TargetName="AccentRail" Property="Background" Value="{DynamicResource ResearchAccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Margin="6,6,6,0"
                           Text="{Binding FilterSummary}"
                           Foreground="{DynamicResource ResearchTextMutedBrush}"
                           FontSize="10"
                           FontFamily="{DynamicResource FontFamilyMono}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsSecondaryPanelCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
