<UserControl x:Class="RegProbe.App.Views.Tweaks.TweakDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="ValueSummaryRowTemplate">
            <Border Background="#0D0D0D"
                    BorderBrush="{DynamicResource ResearchBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,7"
                    Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}"
                               Foreground="{DynamicResource ResearchTextMutedBrush}"
                               FontSize="8"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Value}"
                               Foreground="{DynamicResource ResearchTextPrimaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               TextWrapping="Wrap"
                               Margin="10,0,10,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Detail}"
                               Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                               FontSize="9"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProofBarTemplate">
            <StackPanel Margin="0,0,0,8">
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}"
                               Foreground="{DynamicResource ResearchTextMutedBrush}"
                               FontSize="8"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource FontFamilyMono}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StateText}"
                               Foreground="{Binding FillBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource FontFamilyMono}"/>
                </Grid>
                <Border Height="4"
                        Background="{DynamicResource ResearchBorderBrush}"
                        CornerRadius="2">
                    <Border Background="{Binding FillBrush}"
                            CornerRadius="2"
                            HorizontalAlignment="Stretch"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding FillFactor}"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ProofTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ResearchTextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="GlowRing"
                                    Margin="-1,-1,3,-1"
                                    Background="Transparent"
                                    BorderBrush="{Binding AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      ShadowDepth="0"
                                                      Color="#C32626"
                                                      Opacity="0.85"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Root"
                                    Margin="0,0,4,0"
                                    Padding="9,4"
                                    Background="{DynamicResource ResearchCardBrush}"
                                    BorderBrush="{DynamicResource ResearchBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ResearchBorderHoverBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ResearchPanelBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ResearchTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ResearchAccentBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ResearchPanelBrush}"/>
                                <Setter TargetName="GlowRing" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource ResearchTextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource ResearchCardBrush}"
                BorderBrush="{DynamicResource ResearchBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.ResearchAccentLabel, TargetNullValue=SELECT A TWEAK}"
                               Foreground="{Binding SelectedTweakPane.SelectedTweak.ResearchAccentBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource FontFamilyMono}"/>
                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.Name, TargetNullValue=Select a tweak}"
                               Foreground="{DynamicResource ResearchTextPrimaryBrush}"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RegistryPath}"
                               Foreground="{DynamicResource ResearchTextMutedBrush}"
                               FontSize="10"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                        <Border Margin="0,0,8,0"
                                Background="{Binding SelectedTweakPane.SelectedTweak.ResearchStatusBadgeBackgroundBrush}"
                                BorderBrush="{Binding SelectedTweakPane.SelectedTweak.ResearchStatusBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,3">
                            <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.ResearchStatusBadgeText}"
                                       Foreground="{Binding SelectedTweakPane.SelectedTweak.ResearchStatusBadgeForegroundBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       FontFamily="{DynamicResource FontFamilyMono}"/>
                        </Border>

                        <Border Margin="0,0,8,0"
                                Background="{Binding SelectedTweakPane.SelectedTweak.EvidenceTierBackgroundBrush}"
                                BorderBrush="{Binding SelectedTweakPane.SelectedTweak.EvidenceTierBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3">
                            <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.EvidenceClassBadgeText}"
                                       Foreground="{Binding SelectedTweakPane.SelectedTweak.EvidenceTierForegroundBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       FontFamily="{DynamicResource FontFamilyMono}"/>
                        </Border>

                        <Border Margin="0,0,8,0"
                                Style="{StaticResource MiniBadgeBorderStyle}">
                            <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.CompactStateText}"
                                       Foreground="{DynamicResource ResearchTextPrimaryBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       FontFamily="{DynamicResource FontFamilyMono}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <ToggleButton Margin="0,0,8,0"
                                  Content="VIEW PLAN"
                                  IsChecked="{Binding SelectedTweakPane.IsPlanDrawerExpanded, Mode=TwoWay}"
                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                  Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Content="{Binding SelectedTweakPane.SelectedTweak.ActionButtonText}"
                            Command="{Binding SelectedTweakPane.SelectedTweak.ApplyCommand}"
                            ToolTip="{Binding SelectedTweakPane.SelectedTweak.ConfigurationPrimaryActionTooltip}"
                            Style="{StaticResource ApplyButtonStyle}"
                            Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}"/>

                    <Menu Margin="8,0,0,0"
                          Style="{StaticResource CompactMenuStyle}"
                          Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                        <MenuItem Header="MORE"
                                  Style="{StaticResource CompactMenuItemStyle}">
                            <MenuItem Header="PREVIEW"
                                      Command="{Binding SelectedTweakPane.SelectedTweak.PreviewCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="VERIFY"
                                      Command="{Binding SelectedTweakPane.SelectedTweak.VerifyCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="RESTORE PREVIOUS STATE"
                                      Command="{Binding SelectedTweakPane.SelectedTweak.RollbackCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <Separator/>
                            <MenuItem Header="COPY REGISTRY PATH"
                                      Command="{Binding SelectedTweakPane.SelectedTweak.CopyRegistryPathCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <Separator/>
                            <MenuItem Header="PREVIEW VISIBLE"
                                      Command="{Binding PreviewAllCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="APPLY VISIBLE"
                                      Command="{Binding ApplyAllCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="VERIFY VISIBLE"
                                      Command="{Binding VerifyAllCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="ROLLBACK VISIBLE"
                                      Command="{Binding RollbackAllCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Background="{DynamicResource ResearchCardBrush}"
                BorderBrush="{DynamicResource ResearchBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid Margin="22,18,22,18"
                      Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="WHAT IT DOES"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.FriendlyDescription}"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource SectionBodyStyle}"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.EffectSummary}"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Style="{StaticResource SectionDividerStyle}">
                                <StackPanel>
                                    <TextBlock Text="VALUES"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <ItemsControl Margin="0,8,0,0"
                                                  ItemsSource="{Binding SelectedTweakPane.SelectedTweak.ValueSummaryRows}"
                                                  ItemTemplate="{StaticResource ValueSummaryRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionDividerStyle}">
                                <StackPanel>
                                    <TextBlock Text="CURRENT -&gt; PROPOSED"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <Border Margin="0,8,0,0"
                                            Background="#0D0D0D"
                                            BorderBrush="{DynamicResource ResearchBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,9">
                                        <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.ConfigurationCompactInfoLine}"
                                                   Foreground="{DynamicResource ResearchTextPrimaryBrush}"
                                                   FontFamily="{DynamicResource FontFamilyMono}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionDividerStyle}"
                                    Visibility="{Binding SelectedTweakPane.SelectedTweak.HasResearchHoldMessage, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="RESEARCH HOLD"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <Border Margin="0,8,0,0"
                                            Background="#110000"
                                            BorderBrush="#3A0000"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="INTENTIONAL HOLD"
                                                       Foreground="{DynamicResource ResearchAccentBrush}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       FontFamily="{DynamicResource FontFamilyMono}"/>
                                            <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.ResearchHoldMessage}"
                                                       Margin="0,5,0,0"
                                                       Foreground="#AA4444"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionDividerStyle}">
                                <StackPanel>
                                    <TextBlock Text="PROOF"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <TabControl Margin="0,8,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ItemsSource="{Binding SelectedTweakPane.SelectedTweak.ProofLanes}"
                                                ItemContainerStyle="{StaticResource ProofTabItemStyle}">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D0D0D"
                                                        BorderBrush="{DynamicResource ResearchBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12"
                                                        Margin="0,10,0,0">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"
                                                                       FontFamily="{DynamicResource FontFamilyMono}"/>
                                                            <Border Grid.Column="1"
                                                                    Background="{Binding StateBackgroundBrush}"
                                                                    BorderBrush="{Binding StateBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2">
                                                                <TextBlock Text="{Binding StateText}"
                                                                           Foreground="{Binding StateForegroundBrush}"
                                                                           FontSize="8"
                                                                           FontWeight="Bold"
                                                                           FontFamily="{DynamicResource FontFamilyMono}"/>
                                                            </Border>
                                                        </Grid>

                                                        <TextBlock Text="{Binding Summary}"
                                                                   Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}"/>
                                                        <TextBlock Text="{Binding EmptyMessage}"
                                                                   Foreground="{DynamicResource ResearchTextMutedBrush}"
                                                                   FontSize="11"
                                                                   FontFamily="{DynamicResource FontFamilyMono}"
                                                                   Visibility="{Binding HasSummary, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                                        <Border Margin="0,6,0,0"
                                                                Background="{DynamicResource ResearchCardBrush}"
                                                                BorderBrush="{DynamicResource ResearchBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10,7"
                                                                Visibility="{Binding HasPrimarySourceText, Converter={StaticResource BoolToVisibility}}">
                                                            <StackPanel>
                                                                <TextBlock Text="HOW THE PROOF WAS OBTAINED"
                                                                           Foreground="{DynamicResource ResearchTextMutedBrush}"
                                                                           FontSize="8"
                                                                           FontWeight="Bold"
                                                                           FontFamily="{DynamicResource FontFamilyMono}"/>
                                                                <TextBlock Text="{Binding PrimarySourceText}"
                                                                           Margin="0,5,0,0"
                                                                           Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                                                           FontSize="10"
                                                                           FontFamily="{DynamicResource FontFamilyMono}"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <ItemsControl Margin="0,6,0,0"
                                                                      ItemsSource="{Binding Links}"
                                                                      Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Margin="0,0,6,6"
                                                                            Padding="8,4"
                                                                            Background="{DynamicResource ResearchCardBrush}"
                                                                            BorderBrush="{DynamicResource ResearchBorderBrush}"
                                                                            BorderThickness="1"
                                                                            Foreground="{DynamicResource ResearchTextPrimaryBrush}"
                                                                            Command="{Binding DataContext.SelectedTweakPane.SelectedTweak.OpenReferenceLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Url}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Icon}"
                                                                                       FontFamily="{DynamicResource FontFamilyMono}"
                                                                                       Margin="0,0,6,0"/>
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontFamily="{DynamicResource FontFamilyMono}"
                                                                                       FontSize="9"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionDividerStyle}">
                                <StackPanel>
                                    <TextBlock Text="ANALYSIS BARS"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <ItemsControl Margin="0,6,0,0"
                                                  ItemsSource="{Binding SelectedTweakPane.SelectedTweak.ProofBars}"
                                                  ItemTemplate="{StaticResource ProofBarTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionDividerStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.VerdictSummary}"
                                               Style="{StaticResource SectionBodyStyle}"/>
                                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RiskSnapshotText}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RollbackStoryText}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.DetectedFromSummary}"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.AffectsSummary}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RestartAdvice}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RelatedSettingsSummary}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Pick one tweak to inspect"
                               Foreground="{DynamicResource ResearchTextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               FontFamily="{DynamicResource FontFamilyMono}"/>
                    <TextBlock Text="We keep the key path, proof trail, hold reason, and rollback story in one analysis sheet."
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource ResearchTextSecondaryBrush}"
                               FontSize="11"
                               TextAlignment="Center"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               TextWrapping="Wrap"
                               MaxWidth="420"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
