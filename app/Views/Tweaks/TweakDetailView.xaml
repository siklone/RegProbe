<UserControl x:Class="RegProbe.App.Views.Tweaks.TweakDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0F1620"
                BorderBrush="#1B2835"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.Name, TargetNullValue=Select a tweak}"
                               Foreground="#F7FBFF"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Border Margin="0,0,8,0"
                                Tag="{Binding SelectedTweakPane.SelectedTweak.CompactStateTone}"
                                Style="{StaticResource TrustSignalBorderStyle}"
                                Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.CompactStateText}"
                                       Foreground="#F5F8FD"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Border Margin="0,0,8,0"
                                Style="{StaticResource MiniBadgeBorderStyle}"
                                Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RiskBadgeText}"
                                       Foreground="#F5F8FD"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Border Style="{StaticResource MiniBadgeBorderStyle}"
                                Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RollbackSnapshotText}"
                                       Foreground="#F5F8FD"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <ToggleButton Margin="0,0,10,0"
                                  Content="View plan"
                                  IsChecked="{Binding SelectedTweakPane.IsPlanDrawerExpanded, Mode=TwoWay}"
                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                  Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Content="{Binding SelectedTweakPane.SelectedTweak.ActionButtonText}"
                            Command="{Binding SelectedTweakPane.SelectedTweak.ApplyCommand}"
                            ToolTip="{Binding SelectedTweakPane.SelectedTweak.ConfigurationPrimaryActionTooltip}"
                            Style="{StaticResource ApplyButtonStyle}"
                            Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}"/>

                    <Menu Margin="10,0,0,0"
                          Style="{StaticResource CompactMenuStyle}"
                          Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                        <MenuItem Header="More"
                                  Style="{StaticResource CompactMenuItemStyle}">
                            <MenuItem Header="Preview"
                                      Command="{Binding SelectedTweakPane.SelectedTweak.PreviewCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="Verify"
                                      Command="{Binding SelectedTweakPane.SelectedTweak.VerifyCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="Restore previous state"
                                      Command="{Binding SelectedTweakPane.SelectedTweak.RollbackCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <Separator/>
                            <MenuItem Header="Copy registry path"
                                      Command="{Binding SelectedTweakPane.SelectedTweak.CopyRegistryPathCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <Separator/>
                            <MenuItem Header="Preview visible"
                                      Command="{Binding PreviewAllCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="Apply visible"
                                      Command="{Binding ApplyAllCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="Verify visible"
                                      Command="{Binding VerifyAllCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                            <MenuItem Header="Rollback visible"
                                      Command="{Binding RollbackAllCommand}"
                                      Style="{StaticResource CompactMenuItemStyle}"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Background="#0F1620"
                BorderBrush="#1B2835"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid Margin="28,24,28,24"
                      Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Impact"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.FriendlyDescription}"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource SectionBodyStyle}"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.EffectSummary}"
                                           Margin="0,8,0,0"
                                           Foreground="#7C8DA2"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Style="{StaticResource SectionDividerStyle}">
                                <StackPanel>
                                    <TextBlock Text="Current → Proposed"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.ConfigurationCompactInfoLine}"
                                               Margin="0,8,0,0"
                                               Foreground="#DCE7F6"
                                               FontFamily="{DynamicResource FontFamilyMono}"
                                               FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionDividerStyle}"
                                    Visibility="{Binding SelectedTweakPane.SelectedTweak.HasResearchGateMessage, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Current decision"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.ResearchGateMessage}"
                                               Margin="0,8,0,0"
                                               Foreground="#E8C17B"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionDividerStyle}">
                                <Expander Background="Transparent"
                                          BorderBrush="Transparent"
                                          IsExpanded="{Binding SelectedTweakPane.IsEvidenceExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Evidence"
                                                       Foreground="#F6FAFF"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="Docs • Runtime • Source • Rollback"
                                                       Foreground="#77869A"
                                                       FontSize="11"/>
                                        </DockPanel>
                                    </Expander.Header>

                                    <StackPanel Margin="0,12,0,0">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="✓ Docs" Foreground="#DDE7F4" FontSize="12"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedTweakPane.SelectedTweak.DocsSnapshotText}"
                                                       Foreground="#91A1B6"
                                                       FontSize="12"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="✓ Runtime" Foreground="#DDE7F4" FontSize="12"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedTweakPane.SelectedTweak.RuntimeSnapshotText}"
                                                       Foreground="#91A1B6"
                                                       FontSize="12"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="✓ Source" Foreground="#DDE7F4" FontSize="12"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedTweakPane.SelectedTweak.SourceSnapshotText}"
                                                       Foreground="#91A1B6"
                                                       FontSize="12"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="✓ Rollback" Foreground="#DDE7F4" FontSize="12"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedTweakPane.SelectedTweak.RollbackSnapshotText}"
                                                       Foreground="#91A1B6"
                                                       FontSize="12"/>
                                        </Grid>

                                        <ToggleButton Margin="0,14,0,0"
                                                      HorizontalAlignment="Left"
                                                      Content="View details"
                                                      IsChecked="{Binding SelectedTweakPane.SelectedTweak.IsDetailsExpanded, Mode=TwoWay}"
                                                      Style="{StaticResource SecondaryToggleButtonStyle}"/>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding SelectedTweakPane.SelectedTweak.IsDetailsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.VerdictSummary}"
                                           Style="{StaticResource SectionBodyStyle}"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RiskSnapshotText}"
                                           Margin="0,8,0,0"
                                           Foreground="#9EB0C4"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RollbackStoryText}"
                                           Margin="0,8,0,0"
                                           Foreground="#9EB0C4"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.DetectedFromSummary}"
                                           Margin="0,12,0,0"
                                           Foreground="#8294AA"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.AffectsSummary}"
                                           Margin="0,8,0,0"
                                           Foreground="#8294AA"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RestartAdvice}"
                                           Margin="0,8,0,0"
                                           Foreground="#8294AA"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedTweakPane.SelectedTweak.RelatedSettingsSummary}"
                                           Margin="0,8,0,0"
                                           Foreground="#8294AA"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Pick one tweak to inspect"
                               Foreground="#F4F8FD"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="We’ll keep the decision, proof snapshot, and rollback story in one place."
                               Margin="0,8,0,0"
                               Foreground="#7D8D9F"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="380"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
