<UserControl x:Class="RegProbe.App.Views.Tweaks.PlanLogDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Background="#0F1620"
            BorderBrush="#1B2835"
            BorderThickness="1"
            CornerRadius="14"
            Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
        <Expander Background="Transparent"
                  BorderBrush="Transparent"
                  IsExpanded="{Binding SelectedTweakPane.IsPlanDrawerExpanded, Mode=TwoWay}">
            <Expander.Header>
                <Grid Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTweakPane.DrawerTitle}"
                                   Foreground="#F5F8FD"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedTweakPane.DrawerSummary}"
                                   Margin="0,3,0,0"
                                   Foreground="#8EA0B5"
                                   FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Copy"
                                Margin="0,0,6,0"
                                Command="{Binding SelectedTweakPane.CopyPlanCommand}"
                                Style="{StaticResource ConfigurationSecondaryActionButtonStyle}"/>
                        <Button Content="Export"
                                Margin="0,0,6,0"
                                Command="{Binding SelectedTweakPane.ExportPlanCommand}"
                                Style="{StaticResource ConfigurationSecondaryActionButtonStyle}"/>
                        <Button Content="View rollback"
                                Command="{Binding SelectedTweakPane.SelectedTweak.RollbackCommand}"
                                Style="{StaticResource ConfigurationSecondaryActionButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Expander.Header>

            <Border Padding="14,0,14,14">
                <Grid>
                    <ItemsControl ItemsSource="{Binding SelectedTweakPane.PlanLines}"
                                  Visibility="{Binding SelectedTweakPane.IsExecutionMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,6,0,0"
                                        Padding="10,8"
                                        Background="#0B1119"
                                        BorderBrush="#1E2937"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="{Binding}"
                                               Foreground="#D5E0EE"
                                               FontFamily="{DynamicResource FontFamilyMono}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,6,0,0"
                            Padding="10"
                            Background="#0B1119"
                            BorderBrush="#1E2937"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding SelectedTweakPane.IsExecutionMode, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="220">
                            <TextBlock Text="{Binding SelectedTweakPane.ExecutionLogText}"
                                       Foreground="#D5E0EE"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Expander>
    </Border>
</UserControl>
