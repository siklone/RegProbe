<UserControl x:Class="RegProbe.App.Views.Tweaks.PlanLogDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="DrawerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#A7B7C9"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#142030"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ResearchAccentBrush}"/>
                                <Setter Property="Foreground" Value="#F2F6FC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerLogCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#0B1119"/>
            <Setter Property="BorderBrush" Value="#1E2937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#0F1620"
            BorderBrush="#1B2835"
            BorderThickness="1"
            CornerRadius="14"
            Visibility="{Binding SelectedTweakPane.HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
        <Expander Background="Transparent"
                  BorderBrush="Transparent"
                  IsExpanded="{Binding SelectedTweakPane.IsPlanDrawerExpanded, Mode=TwoWay}">
            <Expander.Header>
                <Grid Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTweakPane.DrawerTitle}"
                                   Foreground="#F5F8FD"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyMono}"/>
                        <TextBlock Text="{Binding SelectedTweakPane.DrawerSummary}"
                                   Margin="0,2,0,0"
                                   Foreground="#8EA0B5"
                                   FontSize="10"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1"
                               VerticalAlignment="Center">
                        <Button Content="Copy"
                                Command="{Binding SelectedTweakPane.CopyPlanCommand}"
                                Style="{StaticResource DrawerActionButtonStyle}"/>
                        <Button Content="Export"
                                Command="{Binding SelectedTweakPane.ExportPlanCommand}"
                                Style="{StaticResource DrawerActionButtonStyle}"/>
                        <Button Content="View rollback"
                                Command="{Binding SelectedTweakPane.SelectedTweak.RollbackCommand}"
                                Style="{StaticResource DrawerActionButtonStyle}"/>
                    </WrapPanel>
                </Grid>
            </Expander.Header>

            <Border Padding="12,0,12,12">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="220"
                                  Visibility="{Binding SelectedTweakPane.IsExecutionMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding SelectedTweakPane.PlanLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DrawerLogCardStyle}">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#D5E0EE"
                                                   FontFamily="{DynamicResource FontFamilyMono}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Style="{StaticResource DrawerLogCardStyle}"
                            Visibility="{Binding SelectedTweakPane.IsExecutionMode, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="220">
                            <TextBlock Text="{Binding SelectedTweakPane.ExecutionLogText}"
                                       Foreground="#D5E0EE"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Expander>
    </Border>
</UserControl>
