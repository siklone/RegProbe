<UserControl x:Class="RegProbe.App.Views.WorkspaceShellChrome"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource ResearchBackgroundBrush}"
             FontFamily="{DynamicResource FontFamilyText}"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RegProbe.App;component/Resources/TweaksWorkspaceResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ResearchBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource ResearchCardBrush}"
                BorderBrush="#0E0E0E"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="12,10,12,4"
                           Text="{Binding WorkspaceCategoryHeader}"
                           Style="{StaticResource SectionEyebrowStyle}"/>

                <Button Grid.Row="1"
                        Margin="0,0,0,1"
                        Command="{Binding ClearCategorySelectionCommand}"
                        Tag="{Binding IsAllCategoriesSelected}"
                        Style="{StaticResource SidebarButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{DynamicResource ResearchAccentBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AllItemsLabel}"
                                       FontSize="10"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       Foreground="{DynamicResource ResearchTextPrimaryBrush}"/>
                            <Border Grid.Column="2"
                                    Background="{DynamicResource ResearchPanelBrush}"
                                    BorderBrush="{DynamicResource ResearchBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="5,2"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,12,0">
                                <TextBlock Text="{Binding CurrentWorkspaceItemCount}"
                                           FontSize="10"
                                           FontFamily="{DynamicResource FontFamilyMono}"
                                           Foreground="{DynamicResource ResearchTextMutedBrush}"/>
                            </Border>
                        </Grid>
                </Button>

                <ListBox Grid.Row="2"
                         Margin="0,0,0,0"
                         ItemsSource="{Binding CategoryGroups}"
                         SelectedValuePath="CategoryName"
                         SelectedValue="{Binding SelectedCategoryName, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{Binding ResearchAccentBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ResearchAccentLabel}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           FontFamily="{DynamicResource FontFamilyMono}"
                                           Foreground="{DynamicResource ResearchTextSecondaryBrush}"/>
                                <Border Grid.Column="2"
                                        Background="{DynamicResource ResearchPanelBrush}"
                                        BorderBrush="{DynamicResource ResearchBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="5,2"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CountBadge}"
                                               FontSize="10"
                                               FontFamily="{DynamicResource FontFamilyMono}"
                                               Foreground="{DynamicResource ResearchTextMutedBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3"
                        BorderBrush="#0E0E0E"
                        BorderThickness="0,1,0,0"
                        Padding="12,7,12,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ResearchSuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding InventoryStatusMessage}"
                                   FontSize="10"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   Foreground="{DynamicResource ResearchTextMutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentPresenter Grid.Column="1"
                          Content="{Binding ElementName=Root, Path=ShellContent}"/>
    </Grid>
</UserControl>
