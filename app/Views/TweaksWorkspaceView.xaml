<UserControl x:Class="RegProbe.App.Views.TweaksWorkspaceView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RegProbe.App.Behaviors"
             mc:Ignorable="d"
             Background="#0B0F14"
             FontFamily="{DynamicResource FontFamilyText}"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RegProbe.App;component/Resources/TweaksWorkspaceResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SecondaryPanelButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Background" Value="#121A24"/>
                <Setter Property="BorderBrush" Value="#243142"/>
                <Setter Property="Foreground" Value="#D7E3F4"/>
            </Style>

            <Style x:Key="SecondaryToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#314154"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#96A6BA"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#111A25"/>
                                    <Setter Property="Foreground" Value="#DCE6F5"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#142338"/>
                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="#4F8CFF"/>
                                    <Setter Property="Foreground" Value="#F5F8FD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CompactSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SearchBoxStyle}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
            </Style>

            <Style x:Key="CompactFilterComboStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Foreground" Value="#EAF1FB"/>
                <Setter Property="Background" Value="#121A24"/>
                <Setter Property="BorderBrush" Value="#263242"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,2"/>
            </Style>

            <Style x:Key="SecondaryPanelListItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#1E2937"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#101925"/>
                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="#2E4056"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#122131"/>
                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="#4F8CFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MiniBadgeBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="CornerRadius" Value="999"/>
                <Setter Property="Background" Value="#142032"/>
                <Setter Property="BorderBrush" Value="#2F4663"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="TrustSignalBorderStyle" TargetType="Border" BasedOn="{StaticResource MiniBadgeBorderStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="ok">
                        <Setter Property="Background" Value="#102117"/>
                        <Setter Property="BorderBrush" Value="#2E7D4F"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="warning">
                        <Setter Property="Background" Value="#2A2212"/>
                        <Setter Property="BorderBrush" Value="#8A5B18"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="muted">
                        <Setter Property="Background" Value="#1B212A"/>
                        <Setter Property="BorderBrush" Value="#4B5563"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SectionDividerStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#1E2937"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="Padding" Value="0,16,0,0"/>
                <Setter Property="Margin" Value="0,16,0,0"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#F6FAFF"/>
            </Style>

            <Style x:Key="SectionBodyStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B4C0D0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CompactMenuStyle" TargetType="Menu">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style x:Key="CompactMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Foreground" Value="#DCE6F5"/>
                <Setter Property="Background" Value="#121A24"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#0B0F14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SecondaryPanelWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0F1620"
                BorderBrush="#1A2431"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="16,14,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding ToggleSecondaryPanelCommand}"
                            Style="{StaticResource SecondaryPanelButtonStyle}"
                            Width="28"
                            Padding="0"
                            Content="☰"/>

                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                Visibility="{Binding IsSecondaryPanelCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Tweaks"
                                   Foreground="#F5F9FF"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Search, filter, and select one validated surface at a time."
                                   Margin="0,3,0,0"
                                   Foreground="#7D8A9C"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1"
                            Margin="16,0,16,12"
                            Visibility="{Binding IsSecondaryPanelCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CompactSearchBoxStyle}"
                             Tag="{Binding SearchPlaceholder}"
                             ToolTip="{Binding SearchPlaceholder}">
                        <i:Interaction.Behaviors>
                            <behaviors:FocusOnRequestBehavior RequestToken="{Binding SearchFocusRequestId}"/>
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="16,0,16,12"
                            Visibility="{Binding IsSecondaryPanelCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Filters"
                               Style="{StaticResource SectionEyebrowStyle}"
                               Margin="0,0,0,8"/>

                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox Tag="Safe" IsChecked="{Binding ShowSafe}" Style="{StaticResource ChipStyle}"><TextBlock Text="Low"/></CheckBox>
                        <CheckBox Tag="Advanced" IsChecked="{Binding ShowAdvanced}" Style="{StaticResource ChipStyle}"><TextBlock Text="Advanced"/></CheckBox>
                        <CheckBox Tag="Risky" IsChecked="{Binding ShowRisky}" Style="{StaticResource ChipStyle}"><TextBlock Text="High"/></CheckBox>
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding StatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource CompactFilterComboStyle}">
                            <ComboBoxItem Content="All statuses" Tag=""/>
                            <ComboBoxItem Content="Applied" Tag="applied"/>
                            <ComboBoxItem Content="Rolled back" Tag="rolledback"/>
                        </ComboBox>

                        <ComboBox Grid.Column="2"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding ScopeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource CompactFilterComboStyle}">
                            <ComboBoxItem Content="All scopes" Tag=""/>
                            <ComboBoxItem Content="Machine" Tag="machine"/>
                            <ComboBoxItem Content="User" Tag="user"/>
                            <ComboBoxItem Content="Mixed" Tag="mixed"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="3"
                      Margin="10,0,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding TweaksView}"
                             SelectedItem="{Binding SelectedTweak, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SecondaryPanelListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="28"
                                            Height="28"
                                            CornerRadius="8"
                                            Background="#162437"
                                            BorderBrush="#294263"
                                            BorderThickness="1"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CategoryIcon}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Visibility="{Binding DataContext.IsSecondaryPanelCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#F3F7FD"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ConfigurationFriendlyDescription}"
                                                   Margin="0,3,0,6"
                                                   Foreground="#90A0B5"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <DockPanel LastChildFill="False">
                                            <StackPanel Orientation="Horizontal"
                                                        DockPanel.Dock="Left">
                                                <Ellipse Width="7"
                                                         Height="7"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#5B708A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CompactStateTone}" Value="ok">
                                                                    <Setter Property="Fill" Value="#36D07F"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CompactStateTone}" Value="warning">
                                                                    <Setter Property="Fill" Value="#F2C94C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CompactStateTone}" Value="muted">
                                                                    <Setter Property="Fill" Value="#8C97A6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding CompactStateText}"
                                                           Foreground="#B9C6D6"
                                                           FontSize="11"
                                                           Margin="0,0,10,0"/>
                                            </StackPanel>

                                            <Border DockPanel.Dock="Right"
                                                    Style="{StaticResource MiniBadgeBorderStyle}">
                                                <TextBlock Text="{Binding RiskBadgeText}"
                                                           Foreground="#EAF1FB"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1"
                               Margin="8,8,8,0"
                               Text="{Binding FilterSummary}"
                               Foreground="#6E7D90"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsSecondaryPanelCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0F1620"
                    BorderBrush="#1B2835"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTweak.Name, TargetNullValue=Select a tweak}"
                                   Foreground="#F7FBFF"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <Border Tag="{Binding SelectedTweak.CompactStateTone}"
                                    Style="{StaticResource TrustSignalBorderStyle}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedTweak.CompactStateText}"
                                           Foreground="#F5F8FD"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <Border Style="{StaticResource MiniBadgeBorderStyle}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedTweak.RiskBadgeText}"
                                           Foreground="#F5F8FD"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <Border Style="{StaticResource MiniBadgeBorderStyle}"
                                    Visibility="{Binding HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedTweak.RollbackSnapshotText}"
                                           Foreground="#F5F8FD"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <ToggleButton IsChecked="{Binding IsPlanDrawerExpanded, Mode=TwoWay}"
                                      Margin="0,0,10,0"
                                      Style="{StaticResource SecondaryToggleButtonStyle}"
                                      Content="View plan"
                                      Visibility="{Binding HasSelectedTweak, Converter={StaticResource BoolToVisibility}}"/>

                        <Button Content="{Binding SelectedTweak.ActionButtonText}"
                                Command="{Binding SelectedTweak.ApplyCommand}"
                                ToolTip="{Binding SelectedTweak.ConfigurationPrimaryActionTooltip}"
                                Style="{StaticResource ApplyButtonStyle}"
                                Visibility="{Binding HasSelectedTweak, Converter={StaticResource BoolToVisibility}}"/>

                        <Menu Margin="10,0,0,0"
                              Style="{StaticResource CompactMenuStyle}"
                              Visibility="{Binding HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem Header="More"
                                      Style="{StaticResource CompactMenuItemStyle}">
                                <MenuItem Header="Preview"
                                          Command="{Binding SelectedTweak.PreviewCommand}"
                                          Style="{StaticResource CompactMenuItemStyle}"/>
                                <MenuItem Header="Verify"
                                          Command="{Binding SelectedTweak.VerifyCommand}"
                                          Style="{StaticResource CompactMenuItemStyle}"/>
                                <MenuItem Header="Restore previous state"
                                          Command="{Binding SelectedTweak.RollbackCommand}"
                                          Style="{StaticResource CompactMenuItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="Copy registry path"
                                          Command="{Binding SelectedTweak.CopyRegistryPathCommand}"
                                          Style="{StaticResource CompactMenuItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="Preview visible"
                                          Command="{Binding PreviewAllCommand}"
                                          Style="{StaticResource CompactMenuItemStyle}"/>
                                <MenuItem Header="Apply visible"
                                          Command="{Binding ApplyAllCommand}"
                                          Style="{StaticResource CompactMenuItemStyle}"/>
                                <MenuItem Header="Verify visible"
                                          Command="{Binding VerifyAllCommand}"
                                          Style="{StaticResource CompactMenuItemStyle}"/>
                                <MenuItem Header="Rollback visible"
                                          Command="{Binding RollbackAllCommand}"
                                          Style="{StaticResource CompactMenuItemStyle}"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,16,0,16"
                    Background="#0F1620"
                    BorderBrush="#1B2835"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid Margin="28,24,28,24"
                          Visibility="{Binding HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Impact"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding SelectedTweak.FriendlyDescription}"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource SectionBodyStyle}"/>
                                    <TextBlock Text="{Binding SelectedTweak.EffectSummary}"
                                               Margin="0,8,0,0"
                                               Foreground="#7C8DA2"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Style="{StaticResource SectionDividerStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Current → Proposed"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="{Binding SelectedTweak.ConfigurationCompactInfoLine}"
                                                   Margin="0,8,0,0"
                                                   Foreground="#DCE7F6"
                                                   FontFamily="{DynamicResource FontFamilyMono}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionDividerStyle}"
                                        Visibility="{Binding SelectedTweak.HasResearchGateMessage, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Current decision"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="{Binding SelectedTweak.ResearchGateMessage}"
                                                   Margin="0,8,0,0"
                                                   Foreground="#E8C17B"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionDividerStyle}">
                                    <Expander IsExpanded="{Binding IsSelectedTweakEvidenceExpanded, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderBrush="Transparent">
                                        <Expander.Header>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="Evidence"
                                                           Foreground="#F6FAFF"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="Docs • Runtime • Source • Rollback"
                                                           Foreground="#77869A"
                                                           FontSize="11"/>
                                            </DockPanel>
                                        </Expander.Header>

                                        <StackPanel Margin="0,12,0,0">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="✓ Docs" Foreground="#DDE7F4" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedTweak.DocsSnapshotText}" Foreground="#91A1B6" FontSize="12"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="✓ Runtime" Foreground="#DDE7F4" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedTweak.RuntimeSnapshotText}" Foreground="#91A1B6" FontSize="12"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="✓ Source" Foreground="#DDE7F4" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedTweak.SourceSnapshotText}" Foreground="#91A1B6" FontSize="12"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="✓ Rollback" Foreground="#DDE7F4" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedTweak.RollbackSnapshotText}" Foreground="#91A1B6" FontSize="12"/>
                                            </Grid>

                                            <ToggleButton IsChecked="{Binding SelectedTweak.IsDetailsExpanded, Mode=TwoWay}"
                                                          Margin="0,14,0,0"
                                                          Content="View details"
                                                          HorizontalAlignment="Left"
                                                          Style="{StaticResource SecondaryToggleButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding SelectedTweak.IsDetailsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SelectedTweak.VerdictSummary}"
                                               Style="{StaticResource SectionBodyStyle}"/>
                                    <TextBlock Text="{Binding SelectedTweak.RiskSnapshotText}"
                                               Margin="0,8,0,0"
                                               Foreground="#9EB0C4"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweak.RollbackStoryText}"
                                               Margin="0,8,0,0"
                                               Foreground="#9EB0C4"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweak.DetectedFromSummary}"
                                               Margin="0,12,0,0"
                                               Foreground="#8294AA"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweak.AffectsSummary}"
                                               Margin="0,8,0,0"
                                               Foreground="#8294AA"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweak.RestartAdvice}"
                                               Margin="0,8,0,0"
                                               Foreground="#8294AA"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTweak.RelatedSettingsSummary}"
                                               Margin="0,8,0,0"
                                               Foreground="#8294AA"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedTweak, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Pick one tweak to inspect"
                                   Foreground="#F4F8FD"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="We’ll keep the decision, proof snapshot, and rollback story in one place."
                                   Margin="0,8,0,0"
                                   Foreground="#7D8D9F"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#0F1620"
                    BorderBrush="#1B2835"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="{Binding HasSelectedTweak, Converter={StaticResource BoolToVisibility}}">
                <Expander IsExpanded="{Binding IsPlanDrawerExpanded, Mode=TwoWay}"
                          Background="Transparent"
                          BorderBrush="Transparent">
                    <Expander.Header>
                        <Grid Margin="14,10,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTweakDrawerTitle}"
                                           Foreground="#F5F8FD"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedTweakDrawerSummary}"
                                           Margin="0,4,0,0"
                                           Foreground="#8EA0B5"
                                           FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="Copy"
                                        Command="{Binding CopySelectedPlanCommand}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource ConfigurationSecondaryActionButtonStyle}"/>
                                <Button Content="Export"
                                        Command="{Binding ExportSelectedPlanCommand}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource ConfigurationSecondaryActionButtonStyle}"/>
                                <Button Content="View rollback"
                                        Command="{Binding SelectedTweak.RollbackCommand}"
                                        Style="{StaticResource ConfigurationSecondaryActionButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Border Padding="16,0,16,16">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding SelectedTweakPlanLines}"
                                          Visibility="{Binding IsSelectedTweakExecutionMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,8,0,0"
                                                Padding="12,10"
                                                Background="#0B1119"
                                                BorderBrush="#1E2937"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <TextBlock Text="{Binding}"
                                                       Foreground="#D5E0EE"
                                                       FontFamily="{DynamicResource FontFamilyMono}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Visibility="{Binding IsSelectedTweakExecutionMode, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,8,0,0"
                                    Padding="12"
                                    Background="#0B1119"
                                    BorderBrush="#1E2937"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="220">
                                    <TextBlock Text="{Binding SelectedTweakExecutionLogText}"
                                               Foreground="#D5E0EE"
                                               FontFamily="{DynamicResource FontFamilyMono}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Expander>
            </Border>
        </Grid>
    </Grid>
</UserControl>
