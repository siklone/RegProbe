<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:RegProbe.App.ViewModels">
    <DataTemplate x:Key="ConfigurationTweakRowTemplate" DataType="{x:Type viewModels:TweakItemViewModel}">
        <Grid>
            <Border x:Name="Card" Background="#171717" BorderBrush="#2A2A2A" BorderThickness="1"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="104"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Stripe" Grid.Column="0" Background="#434343"/>

                <Grid Grid.Column="1" Margin="12,11,16,11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.RowSpan="3"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Style="{StaticResource RowCheckBoxStyle}"/>

                    <StackPanel Grid.Column="1">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Foreground="#F4F4F4" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Grid.Column="1" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TierPillBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EvidenceClassBadgeText}" Value="A">
                                                <Setter Property="BorderBrush" Value="#6E4EC8"/>
                                                <Setter Property="Background" Value="#261B44"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EvidenceClassBadgeText}" Value="B">
                                                <Setter Property="BorderBrush" Value="#20877D"/>
                                                <Setter Property="Background" Value="#132826"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EvidenceClassBadgeText}" Value="C">
                                                <Setter Property="BorderBrush" Value="#44607A"/>
                                                <Setter Property="Background" Value="#1A222B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EvidenceClassBadgeText}" Value="D">
                                                <Setter Property="BorderBrush" Value="#5E646F"/>
                                                <Setter Property="Background" Value="#24272C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EvidenceClassBadgeText}" Foreground="#EAEAEA" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Column="2">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource RiskPillBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RiskBadgeText}" Value="SAFE">
                                                <Setter Property="BorderBrush" Value="#246B44"/>
                                                <Setter Property="Background" Value="#12261A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RiskBadgeText}" Value="ADVANCED">
                                                <Setter Property="BorderBrush" Value="#285EA8"/>
                                                <Setter Property="Background" Value="#142338"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RiskBadgeText}" Value="RISKY">
                                                <Setter Property="BorderBrush" Value="#8A5B18"/>
                                                <Setter Property="Background" Value="#2E2111"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RiskBadgeText}" Foreground="#EAEAEA" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding ConfigurationFriendlyDescription}"
                                   Foreground="#B8B8B8"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   ToolTip="{Binding FriendlyDescription}"/>

                        <Border BorderBrush="#2A3038"
                                BorderThickness="1"
                                Background="#101418"
                                CornerRadius="10"
                                Padding="11,9"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Verdict"
                                               Foreground="#7F8792"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource EvidencePillBorderStyle}">
                                                <Setter Property="Background" Value="#121826"/>
                                                <Setter Property="BorderBrush" Value="#385171"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VerdictState}" Value="allowed">
                                                        <Setter Property="Background" Value="#112419"/>
                                                        <Setter Property="BorderBrush" Value="#2E7D4F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VerdictState}" Value="blocked">
                                                        <Setter Property="Background" Value="#2B2112"/>
                                                        <Setter Property="BorderBrush" Value="#8B6A2A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VerdictState}" Value="archived">
                                                        <Setter Property="Background" Value="#1C1F24"/>
                                                        <Setter Property="BorderBrush" Value="#5B626D"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding VerdictText}"
                                                   Foreground="#EAEAEA"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding VerdictSummary}"
                                           Foreground="#C8CDD4"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>

                                <WrapPanel Margin="0,0,0,6">
                                    <Border Margin="0,0,6,6">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource EvidencePillBorderStyle}">
                                                <Setter Property="Background" Value="#1C1F24"/>
                                                <Setter Property="BorderBrush" Value="#5B626D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DocsSnapshotState}" Value="ready">
                                                        <Setter Property="Background" Value="#112419"/>
                                                        <Setter Property="BorderBrush" Value="#2E7D4F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocsSnapshotState}" Value="partial">
                                                        <Setter Property="Background" Value="#142338"/>
                                                        <Setter Property="BorderBrush" Value="#285EA8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DocsSnapshotText}" Foreground="#D5DBE3" FontSize="10" FontWeight="Medium"/>
                                    </Border>

                                    <Border Margin="0,0,6,6">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource EvidencePillBorderStyle}">
                                                <Setter Property="Background" Value="#1C1F24"/>
                                                <Setter Property="BorderBrush" Value="#5B626D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RuntimeSnapshotState}" Value="ready">
                                                        <Setter Property="Background" Value="#112419"/>
                                                        <Setter Property="BorderBrush" Value="#2E7D4F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RuntimeSnapshotState}" Value="partial">
                                                        <Setter Property="Background" Value="#142338"/>
                                                        <Setter Property="BorderBrush" Value="#285EA8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RuntimeSnapshotText}" Foreground="#D5DBE3" FontSize="10" FontWeight="Medium"/>
                                    </Border>

                                    <Border Margin="0,0,6,6">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource EvidencePillBorderStyle}">
                                                <Setter Property="Background" Value="#1C1F24"/>
                                                <Setter Property="BorderBrush" Value="#5B626D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SourceSnapshotState}" Value="ready">
                                                        <Setter Property="Background" Value="#112419"/>
                                                        <Setter Property="BorderBrush" Value="#2E7D4F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SourceSnapshotState}" Value="partial">
                                                        <Setter Property="Background" Value="#142338"/>
                                                        <Setter Property="BorderBrush" Value="#285EA8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SourceSnapshotText}" Foreground="#D5DBE3" FontSize="10" FontWeight="Medium"/>
                                    </Border>

                                    <Border Margin="0,0,6,6">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource EvidencePillBorderStyle}">
                                                <Setter Property="Background" Value="#1C1F24"/>
                                                <Setter Property="BorderBrush" Value="#5B626D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RollbackSnapshotState}" Value="ready">
                                                        <Setter Property="Background" Value="#112419"/>
                                                        <Setter Property="BorderBrush" Value="#2E7D4F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RollbackSnapshotState}" Value="partial">
                                                        <Setter Property="Background" Value="#142338"/>
                                                        <Setter Property="BorderBrush" Value="#285EA8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RollbackSnapshotText}" Foreground="#D5DBE3" FontSize="10" FontWeight="Medium"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="{Binding RiskSnapshotText}"
                                           Foreground="#A9B3BE"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding RollbackStoryText}"
                                           Foreground="#A9B3BE"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Border Margin="0,0,10,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource EvidencePillBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEvidenceConfirmed}" Value="True">
                                                <Setter Property="Background" Value="#102317"/>
                                                <Setter Property="BorderBrush" Value="#1E7A43"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓"
                                               Margin="0,0,4,0"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               Visibility="{Binding IsEvidenceConfirmed, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding EvidenceStateText}"
                                               Foreground="#A3A3A3"
                                               FontSize="10"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ConfigurationImpactAreaText}" Foreground="#8D8D8D" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ConfigurationCompactInfoLine}" Foreground="#9EA3AA" FontSize="11" FontFamily="{DynamicResource FontFamilyMono}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ConfigurationInventoryFreshnessText}" Foreground="#757575" FontSize="11"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Margin="0,14,10,14" VerticalAlignment="Top" HorizontalAlignment="Right" Width="78">
                    <Border HorizontalAlignment="Right" MinWidth="68">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusPillBorderStyle}">
                                <Setter Property="Background" Value="{Binding StatusBadgeBackground}"/>
                                <Setter Property="BorderBrush" Value="{Binding StatusBorderBrush}"/>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,14,14,14" VerticalAlignment="Top">
                    <Button Content="{Binding ActionButtonText}" Command="{Binding ApplyCommand}" ToolTip="{Binding PrimaryActionTooltip}" Style="{StaticResource ConfigurationPrimaryActionButtonStyle}"/>
                    <Button Content="Restore" Command="{Binding RollbackCommand}" Style="{StaticResource ConfigurationSecondaryActionButtonStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="#132118"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="#274233"/>
                <Setter TargetName="Stripe" Property="Background" Value="#22C55E"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusText}" Value="Error">
                <Setter TargetName="Card" Property="Background" Value="#241615"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="#5B2D2B"/>
                <Setter TargetName="Stripe" Property="Background" Value="#D36C5F"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="RepairsTweakRowTemplate" DataType="{x:Type viewModels:RepairsItemViewModel}">
        <Grid>
            <Border x:Name="Card" Background="#171717" BorderBrush="#2A2A2A" BorderThickness="1"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="104"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Stripe" Grid.Column="0" Background="#434343"/>

                <Grid Grid.Column="1" Margin="12,11,16,11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.RowSpan="3" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource RowCheckBoxStyle}"/>

                    <StackPanel Grid.Column="1">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Foreground="#F4F4F4" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Grid.Column="1" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TierPillBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EvidenceClassBadgeText}" Value="A">
                                                <Setter Property="BorderBrush" Value="#6E4EC8"/>
                                                <Setter Property="Background" Value="#261B44"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EvidenceClassBadgeText}" Value="B">
                                                <Setter Property="BorderBrush" Value="#20877D"/>
                                                <Setter Property="Background" Value="#132826"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EvidenceClassBadgeText}" Value="D">
                                                <Setter Property="BorderBrush" Value="#5E646F"/>
                                                <Setter Property="Background" Value="#24272C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EvidenceClassBadgeText}" Foreground="#EAEAEA" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Column="2">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource RiskPillBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RiskBadgeText}" Value="SAFE">
                                                <Setter Property="BorderBrush" Value="#246B44"/>
                                                <Setter Property="Background" Value="#12261A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RiskBadgeText}" Value="ADVANCED">
                                                <Setter Property="BorderBrush" Value="#285EA8"/>
                                                <Setter Property="Background" Value="#142338"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RiskBadgeText}" Value="RISKY">
                                                <Setter Property="BorderBrush" Value="#8A5B18"/>
                                                <Setter Property="Background" Value="#2E2111"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RiskBadgeText}" Foreground="#EAEAEA" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding FriendlyDescription}" Foreground="#B8B8B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <WrapPanel>
                            <Border Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource EvidencePillBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEvidenceConfirmed}" Value="True">
                                                <Setter Property="Background" Value="#102317"/>
                                                <Setter Property="BorderBrush" Value="#1E7A43"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓"
                                               Margin="0,0,4,0"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               Visibility="{Binding IsEvidenceConfirmed, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding EvidenceStateText}"
                                               Foreground="#A3A3A3"
                                               FontSize="10"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding CompactInfoLine}" Foreground="#9EA3AA" FontSize="11" FontFamily="{DynamicResource FontFamilyMono}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding InventoryFreshnessText}" Foreground="#757575" FontSize="11"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Margin="0,14,10,14" VerticalAlignment="Top" HorizontalAlignment="Right" Width="78">
                    <Border HorizontalAlignment="Right" MinWidth="68">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusPillBorderStyle}">
                                <Setter Property="Background" Value="{Binding StatusBadgeBackground}"/>
                                <Setter Property="BorderBrush" Value="{Binding StatusBorderBrush}"/>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RepairStatusText}" Foreground="{Binding StatusTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,14,14,14" VerticalAlignment="Top">
                    <Button Content="{Binding RunRepairButtonText}" Command="{Binding RunRepairCommand}" ToolTip="{Binding RunRepairTooltip}" Style="{StaticResource RepairsActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="#132118"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="#274233"/>
                <Setter TargetName="Stripe" Property="Background" Value="#22C55E"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RepairStatusText}" Value="Error">
                <Setter TargetName="Card" Property="Background" Value="#241615"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="#5B2D2B"/>
                <Setter TargetName="Stripe" Property="Background" Value="#D36C5F"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
