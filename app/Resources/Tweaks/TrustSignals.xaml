<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="StatusPillBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#202020"/>
        <Setter Property="BorderBrush" Value="#414141"/>
    </Style>

    <Style x:Key="EvidencePillBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#1A1A1A"/>
        <Setter Property="BorderBrush" Value="#333333"/>
    </Style>

    <Style x:Key="TierPillBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#202020"/>
        <Setter Property="BorderBrush" Value="#4A4A4A"/>
    </Style>

    <Style x:Key="RiskPillBorderStyle" TargetType="Border" BasedOn="{StaticResource TierPillBorderStyle}"/>

    <Style x:Key="WorkspaceSummaryCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#15181C"/>
        <Setter Property="BorderBrush" Value="#2A3038"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="11,9"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="ok">
                <Setter Property="Background" Value="#112419"/>
                <Setter Property="BorderBrush" Value="#2E7D4F"/>
            </Trigger>
            <Trigger Property="Tag" Value="attention">
                <Setter Property="Background" Value="#142338"/>
                <Setter Property="BorderBrush" Value="#285EA8"/>
            </Trigger>
            <Trigger Property="Tag" Value="warning">
                <Setter Property="Background" Value="#2E2111"/>
                <Setter Property="BorderBrush" Value="#8A5B18"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkspaceSummaryValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F3F4F6"/>
        <Setter Property="Margin" Value="0,5,0,3"/>
    </Style>

    <Style x:Key="WorkspaceSummaryDetailStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#B5BEC8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
