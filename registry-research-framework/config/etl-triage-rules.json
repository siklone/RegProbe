{
  "version": "1.0",
  "discard_rules": [
    {
      "rule": "open-close-only",
      "description": "Pure OpenKey/CloseKey without write or value",
      "condition": "operation in [RegOpenKey, RegCloseKey] and no value_name"
    },
    {
      "rule": "shallow-path",
      "description": "Path depth <= 3, too generic",
      "condition": "key_path depth <= 3"
    },
    {
      "rule": "package-registration-churn",
      "description": "PackagedCom/ActivatableClassId noise",
      "condition": "key_path contains PackagedCom or ActivatableClassId"
    },
    {
      "rule": "no-signal",
      "description": "No value_name, no value_data, read-only",
      "condition": "operation == RegQueryValue and no value_name and no value_data"
    },
    {
      "rule": "cryptography-oid-noise",
      "description": "OID registration churn",
      "condition": "key_path contains Cryptography\\OID"
    },
    {
      "rule": "windowsselfhost-fid-noise",
      "description": "FID churn, not actionable",
      "condition": "key_path contains WindowsSelfhost\\FIDs"
    },
    {
      "rule": "wbem-tracing-noise",
      "description": "WBEM tracing provider runtime churn",
      "condition": "key_path contains WBEM\\Tracing\\Providers"
    },
    {
      "rule": "taskcache-dynamic-noise",
      "description": "TaskCache runtime state, not tweak signal",
      "condition": "key_path contains TaskCache\\Tasks and value_name == DynamicInfo"
    },
    {
      "rule": "timestamp-value-noise",
      "description": "Transient timestamp values, no tweak signal",
      "condition": "value_name in [StartTime, LastDownloadTime, LastWriteTime, LastAccessTime]"
    },
    {
      "rule": "diagtrack-noise",
      "description": "Telemetry/DiagTrack runtime state",
      "condition": "key_path contains DiagTrack"
    }
  ]
}
