      },
      "kernel_flags": [
        "PROC_THREAD",
        "LOADER",
        "REGISTRY"
      ],
      "stackwalk_events": [
        "RegCreateKey",
        "RegOpenKey",
        "RegQueryKey",
        "RegSetValue",
        "RegQueryValue",
        "RegDeleteValue",
        "RegCloseKey"
      ],
      "buffer": {
        "size_kb": 1024,
        "min_buffers": 64,
        "max_buffers": 256
      },
      "default_duration_seconds": 60,
      "default_output_root": "C:\\RegProbe-Diag\\etw-stackwalk",
